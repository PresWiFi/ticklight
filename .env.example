# Timezone used for due dates, reminders and the morning summary
TZ=Europe/London

# Telegram (optional). Create a bot with @BotFather and paste its token here.
TELEGRAM_BOT_TOKEN=
# Comma-separated Telegram user ids allowed to use the bot.
# Don't know yours? Start the app, then send /id to your bot.
TELEGRAM_ALLOWED_USERS=

# Morning summary time (HH:MM). Leave empty to disable.
SUMMARY_TIME=08:00
# Send due-time reminders this many minutes early (0 = at the due time)
REMINDER_LEAD_MINUTES=0
# How many days the "Coming up" column covers
UPCOMING_DAYS=7

# Optional: require this token for the web UI and API. Leave empty on a trusted LAN.
API_TOKEN=

PORT=8080
